# Copy to .env and fill in real values locally. Never commit a real .env.
# See docs/gate-0/04-provider-licensing-questions.md before setting real
# Google Maps/Places credentials — caching/attribution terms are not yet
# reviewed, so this Gate 2 build only calls the adapter in "not configured"
# fallback mode until that review happens.

NODE_ENV=development
PORT=3001
LOG_LEVEL=info

# Postgres (matches docker-compose.yml defaults for local dev)
DATABASE_URL=postgresql://questboard:questboard_dev@localhost:5432/questboard

# Redis (cache + BullMQ queues, ADR-004)
REDIS_URL=redis://localhost:6379

# Session auth (cookie-based BFF sessions, per docs/gate-1/04-api-contracts.md)
SESSION_SECRET=replace-with-a-long-random-string
SESSION_COOKIE_NAME=qb_session
# Leave blank in local dev and on Render (web/API are unrelated subdomains
# there) — only set this if the API and web app share a real parent domain
# (e.g. api.yourapp.com / app.yourapp.com), where it would be "yourapp.com".
COOKIE_DOMAIN=

# Web client origin allowed to call the API (CORS)
WEB_ORIGIN=http://localhost:3000

# Browser-visible API base URL for the web app's client-side auth/Forge
# calls (apps/web/lib/apiClient.ts) — safe to expose, it's just a URL.
NEXT_PUBLIC_API_BASE_URL=http://localhost:3001

# Google Maps Platform / Places (ADR-005) — server-side key only.
# Leave blank in local dev to run the Places adapter in stub/degraded mode.
GOOGLE_PLACES_SERVER_API_KEY=
# Separate, domain-restricted key exposed to the browser for map tiles only
# (never the same credential as the server key — see docs/gate-1/09-threat-model.md #11)
GOOGLE_MAPS_BROWSER_API_KEY=

# AI generation provider (ADR-006) — vendor selection deferred; leave blank
# to run all AI services in stub/fallback mode locally.
AI_PROVIDER_API_KEY=
AI_PROVIDER_NAME=

# Object storage (S3-compatible) for evidence/media uploads
S3_ENDPOINT=
S3_BUCKET=
S3_ACCESS_KEY=
S3_SECRET_KEY=
S3_PUBLIC_URL=

# Web push (browser notifications) — generate a VAPID keypair for local dev
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:example@example.com
